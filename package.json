{
  "name": "star-exam-companion-root",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm --dir quiz build",
    "dev": "pnpm --dir quiz dev",
    "dev:local": "pnpm --dir quiz dev:local",
    "e2e": "pnpm --dir quiz e2e",
    "e2e:install": "pnpm --dir quiz e2e:install",
    "gate": "pnpm gate:unit && pnpm gate:browser",
    "gate:unit": "mkdir -p temp/gate && node --test --test-reporter=spec --test-reporter=./quiz/e2e/time-reporter.mjs --test-reporter-destination=stdout --test-reporter-destination=temp/gate/unit.json",
    "gate:browser": "mkdir -p temp/gate && PLAYWRIGHT_JSON_OUTPUT_NAME=\"$PWD/temp/gate/browser.json\" pnpm e2e --reporter=list,json",
    "lint": "pnpm --dir quiz lint",
    "reading:crawl": "pnpm --dir quiz reading:crawl",
    "reading:list": "pnpm --dir quiz reading:list",
    "reading:prune": "pnpm --dir quiz reading:prune",
    "reading:path": "pnpm --dir quiz reading:path",
    "start": "pnpm --dir quiz start",
    "start:local": "pnpm --dir quiz start:local"
  }
}
